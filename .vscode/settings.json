{
  // rust-analyzer: lean but thorough
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.allTargets": true,
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.cargo.extraArgs": ["--profile=dev-fast"],
  "rust-analyzer.lens.enable": true,
  "rust-analyzer.lens.run": true,
  "rust-analyzer.lens.debug": true,
  "rust-analyzer.lens.implementations": true,

  // Rust formatting
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },

  // Bevy pulls a lot of deps — keep telemetry quiet, files LF.
  "files.eol": "\n",
  "telemetry.telemetryLevel": "off",

  // Useful file exclusions so rust-analyzer ignores the target dir noise
  "files.watcherExclude": {
    "**/target/**": true,
    "**/.git/**": true
  }
}
